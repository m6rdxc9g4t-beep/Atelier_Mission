{
  "name": "@atelier-mission/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Client web d'Atelier Mission (React + TypeScript + Vite + Tailwind CSS + Zustand + Lucide Icons).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
