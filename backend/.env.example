# Atelier Mission — backend. Copier en .env (jamais versionné).
HOST=127.0.0.1
PORT=3001
# DATABASE_PATH=./data/atelier-mission.db

# Clé API Brevo (Paramètres Brevo › SMTP & API › Clés API, commence par xkeysib-).
# Lue ici seulement : jamais enregistrée en base ni renvoyée par l'API. Les relances ne partent qu'en mode « En ligne ».
BREVO_API_KEY=

# Planificateur des relances (minutes ; 0 = désactivé, envoi manuel depuis l'écran Relances).
REMINDER_TICK_MINUTES=15

# Plateforme agréée SUPER PDP (facture électronique) : Compte › Applications OAuth › identifiants client_credentials.
# Lus ici seulement. Dépôts et statuts ne partent qu'en mode « En ligne ». Même adresse pour le bac à sable et la production.
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
# SUPERPDP_URL=https://api.superpdp.tech
