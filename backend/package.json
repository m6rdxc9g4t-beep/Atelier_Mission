{
  "name": "@atelier-mission/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API & logique métier d'Atelier Mission (Node.js + Fastify + TypeScript + Drizzle/SQLite).",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "facturx:samples": "tsx scripts/facturx-samples.ts",
    "facturx:validate": "bash scripts/validate-facturx.sh"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pdf-lib": "^1.17.1",
    "typebox": "~1.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
